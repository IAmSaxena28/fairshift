# Copy to .env for local runs. Never commit a real secret.
PORT=8080
# At least 32 random characters, e.g. `openssl rand -hex 32`. If unset, a random one is made per process.
SESSION_SECRET=
# ':memory:' (default) reseeds the demo on every start. A file path keeps data between restarts.
DATABASE_PATH=:memory:
# Set to false to hide the one-tap demo accounts on the sign-in page.
DEMO_MODE=true
